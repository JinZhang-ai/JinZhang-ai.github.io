<div class="honors-grid">
  <article class="honor-card">
    <div class="honor-mark honor-mark--comap">
      <img
        src="{{ '/assets/img/competition-logos/comap-official.png' | relative_url }}"
        alt="COMAP, organizer of MCM/ICM"
        width="200"
        height="129"
        loading="lazy"
      >
    </div>
    <div class="honor-copy">
      <p class="honor-year">2026</p>
      <h3>Mathematical Contest in Modeling / Interdisciplinary Contest in Modeling (MCM/ICM)</h3>
      <p class="honor-award">Honorable Mention (H Award)</p>
      <p class="honor-meta">Top 20% <span>·</span> Team Captain</p>
      <a href="https://www.comap.org/contests/mcm-icm" target="_blank" rel="noopener noreferrer">Official contest website ↗</a>
      {% assign mcm_certificate = site.static_files | where_exp: "file", "file.path contains 'mcm-2026-honorable-mention.pdf'" %}
      {% if mcm_certificate.size > 0 %}
      <a class="honor-certificate-link" href="{{ '/assets/awards/mcm-2026-honorable-mention.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer" aria-label="View 2026 MCM Honorable Mention certificate PDF">Certificate PDF ↗</a>
      {% endif %}
    </div>
  </article>
  <article class="honor-card">
    <div class="honor-mark honor-mark--apmcm">
      <img
        src="{{ '/assets/img/competition-logos/apmcm-official.png' | relative_url }}"
        alt="Official APMCM logo"
        width="143"
        height="66"
        loading="lazy"
      >
    </div>
    <div class="honor-copy">
      <p class="honor-year">2025</p>
      <h3>Asia and Pacific Mathematical Contest in Modeling (APMCM)</h3>
      <p class="honor-award">National First Prize</p>
      <p class="honor-meta">16th Place <span>·</span> Team Captain</p>
      <a href="https://www.apmcm.org/?language=en" target="_blank" rel="noopener noreferrer">Official contest website ↗</a>
      {% assign apmcm_certificate = site.static_files | where_exp: "file", "file.path contains 'apmcm-2025-first-prize.pdf'" %}
      {% if apmcm_certificate.size > 0 %}
      <a class="honor-certificate-link" href="{{ '/assets/awards/apmcm-2025-first-prize.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer" aria-label="View 2025 APMCM First Prize certificate PDF">Certificate PDF ↗</a>
      {% endif %}
    </div>
  </article>
  <article class="honor-card">
    <div class="honor-mark honor-mark--mathorcup">
      <img
        src="{{ '/assets/img/competition-logos/mathorcup-official.png' | relative_url }}"
        alt="Official MathorCup logo"
        width="432"
        height="164"
        loading="lazy"
      >
    </div>
    <div class="honor-copy">
      <p class="honor-year">2025</p>
      <h3>MathorCup Mathematical Application Challenge</h3>
      <p class="honor-award">Third Prize</p>
      <p class="honor-meta">Team Captain</p>
      <a href="https://www.mathorcup.org/" target="_blank" rel="noopener noreferrer">Official contest website ↗</a>
      {% assign mathorcup_certificate = site.static_files | where_exp: "file", "file.path contains 'mathorcup-2025-third-prize.pdf'" %}
      {% if mathorcup_certificate.size > 0 %}
      <a class="honor-certificate-link" href="{{ '/assets/awards/mathorcup-2025-third-prize.pdf' | relative_url }}" target="_blank" rel="noopener noreferrer" aria-label="View 2025 MathorCup Third Prize certificate PDF">Certificate PDF ↗</a>
      {% endif %}
    </div>
  </article>
</div>
